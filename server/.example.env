APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
# 请求地址
HOST = "http://localhost"

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false
PREFIX = la_

[PGSQL]
HOSTNAME = 127.0.0.1
DATABASE = postgres
USERNAME = postgres
PASSWORD = 123456
HOSTPORT = 5432
CHARSET = utf8mb4
PREFIX = la_

[REDIS]
#redis队列使用
HOST = 127.0.0.1
PORT = 6379
PASSWORD = ""
PREFIX = la_                                
SELECT = 9
WS_SELECT = 8
WX_SELECT = 10

[CACHE]
HOST = "127.0.0.1"
PORT = "6379"
PASSWORD = "cs2024"
SELECT = 8
PREFIX = ""

[LANG]
default_lang = zh-cn

[PROJECT]
UNIQUE_IDENTIFICATION = 1234
# 演示环境
DEMO_ENV = false

[PROJECT_KEY]
# API密钥 - 请求各类模型必要的密钥  不要泄露 以及 修改删除
API_KEY = "" 
# 签名密钥 - 用于请求中对参数的校验  不要泄露 以及 修改删除
SIGN_KEY = ""



[WORKERMAN]
# 通道端口
CHANNEL_PROT = 2206
# rpa 端口
RPA_PORT = 2345
# 微信端口
WECHAT_PORT = 2347
# 设备端口  
DEVICE_PORT = 6489
# RPA Redis 读写超时（秒），避免握手绑定永久阻塞
REDIS_TIMEOUT = 2

[QUEUE]
# 素材转码队列
TRANSCODING = media_transcode

 # 切片队列名称，用于处理视频切片任务
VIDEO_SLICE = video_slice

; GEO监测队列(默认 default,与主 worker 共用即可跑通;流量大时可改独立队列并单独起 worker)
GEO_MONITOR = default

[TRANSCODING]
# 转码状态最长等待时间，单位：秒，默认 5 天
STALE_SECONDS = 432000
# 生成视频下发前等待素材转码的最长时间，单位：秒，默认 30 分钟
SUBMIT_STALE_SECONDS = 1800

[GEO]
; 监测口径：web=联网检索 model=模型直答
MONITOR_MODE = web
; 监测并行 worker 数(默认 3)：单 cell 中台联网监测约 40~60s,吞吐 ≈ workers 条/分钟;
; 调 1 退回单进程串行,调大注意中台并发承受力
MONITOR_WORKERS = 3
; 测试辅助接口密钥：配置后 GET /api/geo.geo/cronTick?key=<值> 可立即触发一轮监测消费；
; 留空或删除该行则接口关闭。仅测试环境配置，生产勿开
CRON_TEST_KEY =
; 场景问题是否接入真实搜索联想词（中台 geo_search_suggest）
TIKHUB_SUGGEST = true
; AI推荐话题单次最大数量
MAX_TOPICS = 3
; 投稿效果回收节奏：重抓冷却(小时)/观察窗(天)/每轮上限
TIKHUB_RESYNC_HOURS = 6
TIKHUB_MAX_AGE_DAYS = 30
TIKHUB_MAX_PER_RUN = 200
