APP_DEBUG = false
; 24h 视频生成日期化挑选开关 紧急回滚时改为 false 即退回旧的布尔锁模式 预案见 docs 目录
VIDEO_SYNTHESIS_DATE_MODE = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
# 请求地址
HOST = "http://localhost"

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false
PREFIX = la_

[PGSQL]
HOSTNAME = 127.0.0.1
DATABASE = postgres
USERNAME = postgres
PASSWORD = 123456
HOSTPORT = 5432
CHARSET = utf8mb4
PREFIX = la_

[REDIS]
#redis队列使用
HOST = 127.0.0.1
PORT = 6379
PASSWORD = ""
PREFIX = la_                                
SELECT = 9
WS_SELECT = 8
WX_SELECT = 10

[CACHE]
HOST = "127.0.0.1"
PORT = "6379"
PASSWORD = ""
SELECT = 8
PREFIX = ""

[LANG]
default_lang = zh-cn

[PROJECT]
UNIQUE_IDENTIFICATION = 1234
# 演示环境
DEMO_ENV = false
; 网站名称 地址 域名 留空则由后台配置兜底
WEB_NAME =
WEB_URL =
DOMAIN =
; 微信支付联调专用 仅 APP_DEBUG 开启时生效 用固定 IP 和域名替换真实请求值 生产留空
TEST_WEB_IP =
TEST_WEB_DOMAIN =

[PROJECT_KEY]
# API密钥 - 请求各类模型必要的密钥  不要泄露 以及 修改删除
API_KEY = "" 
# 签名密钥 - 用于请求中对参数的校验  不要泄露 以及 修改删除
SIGN_KEY = ""



[WORKERMAN]
# 通道端口
CHANNEL_PROT = 2206
; 通道地址 workerman 与 php-fpm 不在同一台机器时改成通道服务器的内网 IP
CHANNEL_HOST = 127.0.0.1
# rpa 端口
RPA_PORT = 2345
# 微信端口
WECHAT_PORT = 2347
# 设备端口  
DEVICE_PORT = 6489

[QUEUE]
# 素材转码队列
TRANSCODING = media_transcode

 # 切片队列名称，用于处理视频切片任务
VIDEO_SLICE = video_slice

; GEO监测队列(默认 default,与主 worker 共用即可跑通;流量大时可改独立队列并单独起 worker)
GEO_MONITOR = default

; 爆款仿写生成队列 默认与主 worker 共用 流量大时可改独立队列并单独起 worker
VIDEO_IMITATION = default

[TRANSCODING]
# 转码状态最长等待时间，单位：秒，默认 5 天
STALE_SECONDS = 432000
# 生成视频下发前等待素材转码的最长时间，单位：秒，默认 30 分钟
SUBMIT_STALE_SECONDS = 1800

[GEO]
; 监测口径：web=联网检索 model=模型直答
MONITOR_MODE = web
; 监测并行 worker 数(默认 3)：单 cell 中台联网监测约 40~60s,吞吐 ≈ workers 条/分钟;
; 调 1 退回单进程串行,调大注意中台并发承受力
MONITOR_WORKERS = 3
; 测试辅助接口密钥：配置后 GET /api/geo.geo/cronTick?key=<值> 可立即触发一轮监测消费；
; 留空或删除该行则接口关闭。仅测试环境配置，生产勿开
CRON_TEST_KEY =
; 场景问题是否接入真实搜索联想词（中台 geo_search_suggest）
TIKHUB_SUGGEST = true
; AI推荐话题单次最大数量
MAX_TOPICS = 3
; 投稿效果回收节奏：重抓冷却(小时)/观察窗(天)/每轮上限
TIKHUB_RESYNC_HOURS = 6
TIKHUB_MAX_AGE_DAYS = 30
TIKHUB_MAX_PER_RUN = 200
; 授权凭据加密密钥 64 位 hex 生成方式 openssl rand -hex 32
; 留空则凭据明文落库 配置后新写入加密 已有密文的环境不要清掉 否则历史密文永远解不开
CREDENTIAL_KEY =
; GEO 生成类调用的默认模型别名 留空则由中台默认模型兜底
GEN_DEFAULT =
; 每轮监测定时任务最多消费的条数 默认 30
MONITOR_MAX_PER_RUN = 30


[HOTSPOT]
ARK_SEARCH_MODEL = doubao-seed-character-260628
ARK_WRITER_MODEL = doubao-seed-character-260628

[PLAY_VIDEO]
; 爆款玩法改词首选模型 须在本站上架且启用 否则从已上架对话模型里随机挑 推理模型请用 -none 变体
REWRITE_MODEL = deepseek-v4-pro-none

[MNP]
; 小程序 miniprogram-ci 上传参数 内存不足会 worker 死锁或被 OOM 打死 详见 MnpCiService 注释
; 编译线程数 默认 1 调大必炸默认堆
COMPILE_THREADS = 1
; node 老生代堆上限 MB 0 表示不传 由 node 按机器内存自定 内存不充裕时切勿调大
NODE_HEAP_MB = 0
; 经 NODE_OPTIONS 下发给 fork 子进程的堆上限 MB 0 表示不下发 默认 1536
CHILD_HEAP_MB = 1536
; 上传时压缩代码 必须开 否则分包撞微信 2048KB 上限 仅排查内存问题时临时关
MINIFY = true

[NOTIFY]
# 全站共用回调鉴权令牌 所有免登录异步回调接口统一用它校验
# 随机长串自定 生成方式 openssl rand -hex 24
# 不配置时 新接口回调通道关闭纯靠定时任务兜底 存量接口维持接入前的不鉴权行为
TOKEN =
# 存量回调接口的迁移宽限期截止时间 第一次配置上面的 TOKEN 时一起填
# 填当前时间加一天即可 例如 2026-09-10 00:00:00 也可以填时间戳
# 宽限期内 未带令牌的回调仍然放行 照顾提交时回调地址还没有令牌的在途任务 到点后一律拒绝
LEGACY_UNTIL =
